generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String
  location    String
  excerpt     String
  description String   @db.Text
  coverSrc    String
  coverAlt    String
  coverBlur   String?  // Base64 blur placeholder
  gallery     Json     // ImageAsset[]
  featured    Boolean  @default(false)
  year        String
  scope       String[] // PostgreSQL array
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  coverSrc    String
  coverAlt    String
  coverBlur   String?  // Base64 blur placeholder
  category    String
  featured    Boolean  @default(false)
  publishedAt DateTime
  content     Json     // Fase 1: string[] (paragraphs). Fase 3: Tiptap JSON.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ContactStatus {
  NEW
  READ
  RESPONDED
}

model ContactSubmission {
  id          String        @id @default(cuid())
  name        String
  email       String
  projectType String
  location    String
  message     String        @db.Text
  status      ContactStatus @default(NEW)
  createdAt   DateTime      @default(now())
}

model Service {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String  @db.Text
  icon        String
  imageSrc    String?
  imageAlt    String?
  imageBlur   String? // Base64 blur placeholder
  sortOrder   Int     @default(0)
}

model SiteSetting {
  id               String   @id @default("global") // We only ever have one record
  
  // SEO & General
  siteName         String
  siteDescription  String
  email            String
  phone            String
  address          String
  socials          Json     // { instagram, pinterest, behance }
  
  // Hero
  heroTitle        String
  heroDescription  String   @db.Text
  heroImageSrc     String
  heroImageAlt     String
  heroImageBlur    String?
  heroStatCards    Json     // Array of { label, value, description, icon }

  // About
  aboutLabel       String
  aboutTitle       String
  aboutDescription String   @db.Text
  aboutImageSrc    String
  aboutImageAlt    String
  aboutImageBlur   String?
  aboutBadgeTitle  String?
  aboutBadgeDesc   String?
  aboutValues      Json     // Array of { title, description, icon }

  // Section Headers
  servicesLabel    String
  servicesTitle    String
  servicesDesc     String   @db.Text
  
  projectsLabel    String
  projectsTitle    String
  projectsDesc     String   @db.Text
  
  articlesLabel    String
  articlesTitle    String
  articlesDesc     String   @db.Text

  // Footer & Contact
  contactTitle     String
  contactDesc      String   @db.Text
  footerHeadline   String
  footerSummary    String   @db.Text
  copyright        String

  updatedAt        DateTime @updatedAt
}
